{
  "name": "dotcomma",
  "version": "0.0.2",
  "private": true,
  "dependencies": {
    "@react-three/drei": "^9.87.0",
    "@react-three/fiber": "^8.14.5",
    "@react-three/postprocessing": "^2.16.6",
    "@react-three/rapier": "^1.5.0",
    "delaunator": "^5.0.0",
    "maath": "^0.10.8",
    "noise-ts": "^1.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "seedrandom": "^3.0.5",
    "three": "0.157.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build && cd server && npm ci && npm run build",
    "build:client": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "dev:server": "cd server && npm run dev",
    "start:server": "node server/dist/index.js",
    "db:migrate": "node --env-file-if-exists=server/.env server/dist/cli/migrate.js",
    "db:inspect": "node --env-file-if-exists=server/.env server/dist/cli/inspect.js",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(delaunator|robust-predicates|noise-ts)/)"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@types/delaunator": "^5.0.2",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.54",
    "@types/react": "^18.2.23",
    "@types/react-dom": "^18.2.8",
    "@types/seedrandom": "^3.0.6",
    "@types/three": "^0.170.0"
  },
  "engines": {
    "node": ">=24"
  }
}
