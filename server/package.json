{
  "name": "dotcomma-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts src/cli/migrate.ts src/cli/inspect.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist --outbase=src --sourcemap --log-level=warning",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "db:inspect": "tsx --env-file-if-exists=.env src/cli/inspect.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.28.2"
  }
}
