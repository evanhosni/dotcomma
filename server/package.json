{
  "name": "dotcomma-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "node build.mjs && node --env-file-if-exists=.env dist/cli/migrate.js",
    "db:inspect": "node build.mjs && node --env-file-if-exists=.env dist/cli/inspect.js",
    "test": "node build.mjs && node build.mjs --tests && node --test dist-test/*.test.js",
    "physics:demo": "node build.mjs && node dist/cli/physicsDemo.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.28.2"
  }
}
