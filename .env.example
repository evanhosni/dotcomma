# ── Client (CRA) ─────────────────────────────────────────────────────────────
# Inlined into the bundle at BUILD time; must be prefixed REACT_APP_.
# Lives in `.env` (gitignored) or `.env.development` (committed, dev only).

# Game-server WebSocket URL. Unset = same host as the page (production).
# Dev: the CRA dev server is :3000 and the game server :8080 → set in .env.development.
REACT_APP_WS_URL=ws://localhost:8080

# Public asset CDN origin (Phase 4). No trailing slash.
REACT_APP_CDN_URL=https://cdn.dotcomma.io

# ── Server (server/.env locally; Railway → service Variables) ────────────────
# Read at RUNTIME by node (`--env-file-if-exists=server/.env` in the scripts;
# Railway injects them directly).

# HTTP + WebSocket port. Railway sets this; local default 8080.
PORT=8080

# SQLite file. Railway: a path on the mounted volume, e.g. /data/dotcomma.sqlite.
# Local default: <repo>/data/dotcomma.sqlite (gitignored).
DATABASE_PATH=./data/dotcomma.sqlite

# Set to 1 ONLY for a brand-new database's first boot (empty volume) so the
# server creates the schema itself. Otherwise the server refuses to start on a
# stale schema and you run `npm run db:migrate` explicitly.
DB_AUTO_MIGRATE=0

# ── Asset upload script (FUTURE — Phase 4 deferred until there is an R2 bucket) ──
# R2_BUCKET=dotcomma-assets
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=...        (R2 API token, S3-compatible)
# AWS_SECRET_ACCESS_KEY=...
