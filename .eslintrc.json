{
  "extends": ["react-app", "react-app/jest"],
  "rules": {
    "react-hooks/exhaustive-deps": "off",
    "no-loop-func": "off",
    "no-mixed-operators": "off"
  },
  "overrides": [
    {
      "files": ["*.worker.ts", "*.worker.js"],
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ]
}
